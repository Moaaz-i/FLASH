{
  "name": "flash-zk",
  "version": "1.0.3",
  "description": "Zero-knowledge encrypted intelligence database — local-first, AI-native, server-blind document engine",
  "type": "module",
  "main": "src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./engine/*": "./src/engine/*.mjs",
    "./crypto/*": "./src/crypto/*.mjs",
    "./client/*": "./src/client/*.mjs",
    "./vector/*": "./src/vector/*.mjs",
    "./ai/*": "./src/ai/*.mjs",
    "./server/*": "./src/server/*.mjs"
  },
  "bin": {
    "flashsh": "bin/flashsh.mjs",
    "flash-server": "bin/flash-server.mjs",
    "flash-console": "bin/flash-console.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "benchmark": "node benchmarks/benchmark.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deprecate:problematic-versions": "node scripts/deprecate-problematic-versions.mjs",
    "deprecate:analyze": "ANALYZE=1 node scripts/deprecate-problematic-versions.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "~5.7.0",
    "vitepress": "^1.6.3"
  },
  "keywords": [
    "database",
    "encrypted-database",
    "embedded-database",
    "encrypted-intelligence-db",
    "zero-knowledge",
    "local-first",
    "ai-native",
    "private-rag",
    "agent-memory",
    "sealed-vault",
    "server-blind",
    "langchain",
    "lsm-tree",
    "blind-index",
    "high-performance",
    "zero-copy",
    "vector-search",
    "hnsw",
    "ai-database",
    "homomorphic-encryption",
    "merkle-tree",
    "document-db",
    "nosql",
    "typescript",
    "crash-recovery",
    "transaction",
    "acid"
  ],
  "author": "Moaaz Yahia Zakaria",
  "license": "Apache-2.0",
  "homepage": "https://moaaz-i.github.io/FLASH/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moaaz-i/FLASH.git"
  },
  "bugs": {
    "url": "https://github.com/Moaaz-i/FLASH/issues"
  }
}
